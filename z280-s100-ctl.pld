Name     Z280 S-100 CPU card - control CPLD ;
PartNo   ATF1508 ;
Date     2026-09-06 ;
Revision 2 ;
Designer ;
Company  ;
Assembly ;
Location ;
Device   f1508ispplcc84 ;

/* ============================================================================
 * Z280 S-100 CPU card - control CPLD (CPLD 2, the decider)
 *
 * Everything that DECIDES a cycle. Touches no data line and no address line.
 *
 * Rev 2 adds the running-slave (temporary-master) role, gated by a single
 * MODE strap (pin 64, formerly SLAVE_ONLY):
 *   MODE = 1  ->  permanent master (the original behaviour)
 *   MODE = 0  ->  temporary master (running slave)
 *
 * New signals:
 *   in : GREQ (75)  - Z280 pin 30, multimicro "I want the shared bus"
 *   in : MINE (12)  - from the arb GAL, "you won, bus granted"
 *   out: GACK (76)  - Z280 pin 32, "granted"
 *   out: IWANT (77) - to the arb GAL, "request the bus"
 *
 * Role-dependent handling:
 *   permanent master: HOLD* in -> BUSREQ -> Z280 parks -> pHLDA out
 *   temporary master: GREQ -> IWANT -> GAL (HOLD* + DMA0-3) -> MINE -> GACK
 * In the TMA role the CPLD ignores HOLD/pHLDA (the GAL owns those wires).
 *
 * MASTER/SLAVE split into two independent axes:
 *   Z_OWN  = Z_BUSACK                 (the Z280 owns its bus: gates local RAM)
 *   S100_MASTER = Z_BUSACK & (PM#MINE) (I'm driving the S-100: gates the FSM)
 *   SLAVE  = !Z_BUSACK                (parked: a bus master is in my RAM)
 *
 * Pinout: ATF1508AS 84-pin PLCC. JTAG = TDI 14 / TMS 23 / TCK 62 / TDO 71.
 * DEDICATED inputs: GCLR=1, OE2=2, GCLK1=83, OE1=84 (tied +5V except GCLK1=83
 * = Z_CLK_IN). 64/64 general I/O used.
 * ========================================================================== */

/* *************** INPUT PINS *********************/
PIN 4   = !MEM_WE_H;   /* SRAM high-byte write */
PIN 5   = !MEM_OE;   /* SRAM output enable */
PIN 6   = !MEM_WE_L;   /* SRAM low-byte write */
PIN 8   = !MEM_CE1;   /* SRAM bank1 chip enable (odd) */
PIN 9   = A20;   /* A20 straight off the upper address bus */
PIN 10  = !MEM_CE0;   /* SRAM bank0 chip enable (even) */
PIN 11  = !CFG_OE;   /* BTI 74HCT244 /OE - drive AD0-7 during reset + hold */
PIN 12  = MINE;   /* from arb GAL: "you won, bus granted" (rev 2) */
PIN 15  = Z_DS;   /* Z-BUS data strobe, active low */
PIN 16  = Z_RW;   /* read/write, low = write */
PIN 17  = Z_BW;   /* byte/word, low = word */
PIN 18  = Z_ST0;
PIN 20  = Z_ST1;
PIN 21  = Z_ST2;
PIN 22  = Z_ST3;
PIN 24  = Z_IE;   /* input enable (read), active low */
PIN 25  = Z_BUSACK;   /* BUSACK: 0=relinquished(slave) 1=owns(master) */
PIN 27  = Z_RESET;   /* reset */
PIN 28  = !Z_WAIT;   /* hold the Z280, active low */
PIN 29  = !Z_BUSREQ;   /* request Z280 bus, active low */
PIN 30  = CPLD_sINTA;
PIN 31  = CPLD_sHLTA;
PIN 33  = S100_HOLD;   /* permanent-master role: TMA request, active low */
PIN 34  = S100_pRDY;   /* master ready (slave side always ready) */
PIN 35  = S100_XRDY;   /* ready */
/* ADSB/SDSB/CDSB moved to the data CPLD (rev 2) - see z280-s100-ad.pld. */
PIN 40  = S100_SIXTN;   /* read as master, drive low as slave */
PIN 41  = CPLD_pSYNC;
PIN 44  = !CPLD_pSTVAL;
PIN 45  = CPLD_pDBIN;
PIN 46  = !CPLD_pWR;
PIN 48  = CPLD_pHLDA;
PIN 49  = CPLD_sMEMR;
PIN 50  = !CPLD_sWO;
PIN 51  = CPLD_sINP;
PIN 52  = CPLD_sOUT;
PIN 54  = MST_RD;   /* -> CPLD 1: master S-100 read */
PIN 55  = MST_WR;   /* -> CPLD 1: master S-100 write */
PIN 56  = SLV_RD;   /* -> CPLD 1: TMA reads our SRAM */
PIN 57  = SLV_WR;   /* -> CPLD 1: TMA writes our SRAM */
PIN 58  = SLAVE;   /* -> CPLD 1: board is parked (bus master in RAM) */
PIN 60  = XFR16;   /* -> CPLD 1: 16-bit transfer agreed */
PIN 61  = SPLIT;   /* -> CPLD 1: second byte of a 16->8 split */
PIN 63  = LA0;   /* from CPLD 1: byte lane */
PIN 64  = MODE;   /* strap: 1 = permanent master, 0 = temporary master */
PIN 65  = !CPLD_sXTRQ;
/* A_OE/S_OE/C_OE moved to the data CPLD (rev 2) - see z280-s100-ad.pld. */
PIN 70  = SRAM_WIN;   /* from 74F138 Y0: 2MB window 000000-1FFFFF */
PIN 73  = FLASH_WIN;   /* from 74F521: F00000-F0FFFF */
PIN 74  = SLAVE_WIN;   /* from 74F521: DIP-strapped TMA slave window */
PIN 75  = GREQ;   /* from Z280 pin 30: multimicro grant request (rev 2) */
PIN 76  = GACK;   /* to Z280 pin 32: grant acknowledge (rev 2) */
PIN 77  = IWANT;   /* to arb GAL: request the bus (rev 2) */
PIN 79  = !FLASH_OE;   /* flash output enable */
PIN 80  = !FLASH_WE;   /* 28C256 write enable (in-system EEPROM) */
PIN 81  = !FLASH_CE;   /* flash chip enable */
PIN 83  = Z_CLK_IN;   /* GCK1 - bus clock */
PIN 62  = TCK;   /* JTAG */
PIN 23  = TMS;   /* JTAG */
PIN 14  = TDI;   /* JTAG */
PIN 71  = TDO;   /* JTAG */

/* *************** INTERRUPTS (rev 2, moved back from data CPLD) *************** */
PIN 36  = S100_INT;   /* backplane interrupt, active low */
PIN 37  = S100_NMI;   /* backplane NMI, active low */
PIN 39  = !Z_INT;   /* to Z280 INT-A (active low) */
PIN 67  = !Z_NMI;   /* to Z280 NMI (active low) */

/* *************** STATE REGISTER *************** */
node S1;   /* master FSM: IDLE=00, SYNC=01, DATA=10 */
node S0;
node CNT3; /* reset-config hold counter (15 clocks after reset) */
node CNT2;
node CNT1;
node CNT0;

/* SPLIT is a registered OUTPUT pin (pin 73), not a buried node - it is the
 * 16->8 split flag, sent to CPLD 1 so it can drive S-100 A0. */

S1.CK = Z_CLK_IN;
S0.CK = Z_CLK_IN;
SPLIT.CK = Z_CLK_IN;
CNT3.CK = Z_CLK_IN;
CNT2.CK = Z_CLK_IN;
CNT1.CK = Z_CLK_IN;
CNT0.CK = Z_CLK_IN;
S1.AR = !Z_RESET;
S0.AR = !Z_RESET;
SPLIT.AR = !Z_RESET;
CNT3.AR = !Z_RESET;
CNT2.AR = !Z_RESET;
CNT1.AR = !Z_RESET;
CNT0.AR = !Z_RESET;

/* *************** COMBINATIONAL DECODE *************** */
MEM   = Z_ST3 & !Z_ST2 & !Z_ST1;              /* 1000/1001 memory */
IO    = !Z_ST3 & !Z_ST2 & Z_ST1 & !Z_ST0;     /* 0010 I/O */
WRITE = !Z_RW;
WORD  = !Z_BW;

/* SRAM_WIN / FLASH_WIN / SLAVE_WIN arrive decoded from the F138 / F521. */
LOCAL_ADDR = SRAM_WIN # FLASH_WIN;

S100_CYCLE = (MEM & !LOCAL_ADDR) # IO;
READY      = S100_pRDY # S100_XRDY;

/* *************** MODE / ROLE (rev 2) *************** */
PM    = MODE;                     /* 1 = permanent master */
TMA   = !MODE;                    /* 1 = temporary master (running slave) */

Z_OWN       = Z_BUSACK;                    /* the Z280 owns its bus: local RAM */
S100_MASTER = Z_BUSACK & (PM # MINE);      /* I'm driving the S-100 bus */
SLAVE       = !Z_BUSACK;                   /* parked: a bus master is in my RAM */

START       = S100_CYCLE & S100_MASTER;
S100_ACTIVE = (S1 # S0) & S100_MASTER;

SPLIT16 = WORD & !S100_SIXTN;   /* word access, slave did NOT ack 16-bit */

BYTE_SEL = LA0 # SPLIT;         /* internal; CPLD 1 drives S-100 A0 */

/* *************** MASTER BRIDGE FSM *************** */
S1.D = (S0 & !S1)
     # (S1 & !S0 & !READY);

S0.D = (!S1 & !S0 & START)
     # (S1 & !S0 & READY & SPLIT16 & !SPLIT);

SPLIT.D = (S1 & !S0 & READY & SPLIT16 & !SPLIT)
        # (SPLIT & !(S1 & !S0 & READY));

/* *************** RESET CONFIG HOLD COUNTER *************** */
/* The Z280 loads its BTI register from AD0-7 on the rising edge of RESET and
 * requires WAIT asserted >=4 clocks before that edge and held >=6 clocks after
 * (p.541/545); AD0-7 hold time equals the WAIT dwell. The CPU won't run until
 * WAIT rises anyway, so we use the full 4-bit count and hold 15 clocks. */
HOLD = !(CNT3 & CNT2 & CNT1 & CNT0); /* 1 while CNT is 0..14 (15 clocks) */
INC  = !Z_RESET & HOLD;         /* count only after reset, stop at 15 */

CNT0.D = CNT0 $ INC;
CNT1.D = CNT1 $ (INC & CNT0);
CNT2.D = CNT2 $ (INC & CNT1 & CNT0);
CNT3.D = CNT3 $ (INC & CNT2 & CNT1 & CNT0);

CFG_OE = HOLD;                  /* BTI 74HCT244 /OE (pin 75, active low) */

/* *************** S-100 CONTROL / STATUS *************** */
CPLD_pSYNC   = S0 & !S1;
CPLD_pSTVAL  = S0 & !S1;
CPLD_pDBIN   = S1 & !S0 & !WRITE;
CPLD_pWR     = S1 & !S0 & WRITE;

Z_WAIT       = S100_ACTIVE # HOLD;

CPLD_sMEMR   = MEM & S100_ACTIVE;
CPLD_sWO     = WRITE & S100_ACTIVE;
CPLD_sINP    = IO & !WRITE & S100_ACTIVE;
CPLD_sOUT    = IO & WRITE & S100_ACTIVE;
CPLD_sINTA   = !Z_ST3 & Z_ST2 & S100_ACTIVE;
CPLD_sHLTA   = !Z_ST3 & !Z_ST2 & Z_ST1 & Z_ST0 & S100_ACTIVE;
CPLD_sXTRQ   = WORD & S100_ACTIVE & !SPLIT;

CPLD_sMEMR.OE  = S100_ACTIVE;
CPLD_sWO.OE    = S100_ACTIVE;
CPLD_sINP.OE   = S100_ACTIVE;
CPLD_sOUT.OE   = S100_ACTIVE;
CPLD_sINTA.OE  = S100_ACTIVE;
CPLD_sHLTA.OE  = S100_ACTIVE;
CPLD_sXTRQ.OE  = S100_ACTIVE;
CPLD_pSYNC.OE  = S100_ACTIVE;
CPLD_pSTVAL.OE = S100_ACTIVE;
CPLD_pDBIN.OE  = S100_ACTIVE;
CPLD_pWR.OE    = S100_ACTIVE;

/* *************** LOCAL MEMORY *************** */
MEM_CE0 = (MEM & SRAM_WIN & Z_OWN & !A20)
        # (SLAVE & SLAVE_WIN & CPLD_sMEMR & !A20);
MEM_CE1 = (MEM & SRAM_WIN & Z_OWN &  A20)
        # (SLAVE & SLAVE_WIN & CPLD_sMEMR &  A20);

MEM_OE  = (Z_IE & Z_OWN & SRAM_WIN)
        # (SLAVE & SLAVE_WIN & CPLD_sMEMR & !CPLD_sWO);

MEM_WE_L = (WRITE & Z_DS & (WORD # !LA0) & SRAM_WIN & Z_OWN)
         # (SLAVE & SLAVE_WIN & CPLD_sMEMR & CPLD_sWO & !BYTE_SEL);
MEM_WE_H = (WRITE & Z_DS & (WORD #  LA0) & SRAM_WIN & Z_OWN)
         # (SLAVE & SLAVE_WIN & CPLD_sMEMR & CPLD_sWO &  BYTE_SEL);

FLASH_CE = MEM & FLASH_WIN & Z_OWN;
FLASH_OE = Z_IE & FLASH_WIN & Z_OWN;
FLASH_WE = WRITE & Z_DS & FLASH_WIN & Z_OWN;

/* *************** ARBITRATION (rev 2) *************** */
/* Outbound, temporary-master role: GREQ -> IWANT -> GAL -> MINE -> GACK. */
IWANT  = TMA & GREQ;
GACK   = TMA & MINE;

/* Inbound: request the Z280's bus.
 *   permanent master: a TMA asserts HOLD (as before)
 *   temporary master: a bus master decodes into my RAM window */
Z_BUSREQ = (PM & !S100_HOLD)
         # (TMA & SLAVE_WIN & (CPLD_sMEMR # CPLD_sWO));

/* pHLDA is the permanent master's exclusive output; only driven in that role.
 * In the TMA role it is tri-stated (the permanent master drives pHLDA and the
 * GAL reads it). */
CPLD_pHLDA    = !Z_BUSACK;
CPLD_pHLDA.OE = PM;

/* SIXTN# (16-bit acknowledge): a master asserts sXTRQ and the slave answers
 * SIXTN. Pin 40 is bidirectional: read as master (SPLIT16), driven open-drain
 * low as slave when a TMA requests 16-bit inside our window. */
S100_SIXTN    = 'b'0;
S100_SIXTN.OE = SLAVE & CPLD_sXTRQ & SLAVE_WIN;

/* BUFFER CONTROL moved to the data CPLD (rev 2) - see z280-s100-ad.pld. */

/* *************** INTERRUPTS (rev 2, moved back from data CPLD) *************** */
/* S-100 INT/NMI are active-low and the Z280 wants them active-low, so the
 * pins (declared !Z_INT/!Z_NMI above) are a net pass-through. */
Z_INT = !S100_INT;
Z_NMI = !S100_NMI;

/* *************** STEERING DECISIONS (-> CPLD 1) *************** */
/* Pre-qualified so the data path has no decode left to do. */
MST_RD = S100_ACTIVE & !WRITE;
MST_WR = S100_ACTIVE &  WRITE;
SLV_RD = SLAVE & SLAVE_WIN & !CPLD_sWO;
SLV_WR = SLAVE & SLAVE_WIN &  CPLD_sWO;

XFR16  = (S100_MASTER & WORD & S100_SIXTN) # (SLAVE & CPLD_sXTRQ);

/* Interrupts (Z_INT/Z_NMI) moved to CPLD 1 (z280-s100-ad.pld). */
