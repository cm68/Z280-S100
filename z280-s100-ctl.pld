Name     Z280 S-100 CPU card - control CPLD ;
PartNo   ATF1508 ;
Date     2026-08-27 ;
Revision 1 ;
Designer ;
Company  ;
Assembly ;
Location ;
Device   f1508ispplcc84 ;

/* ============================================================================
 * Z280 S-100 CPU card - control CPLD (CPLD 2, the decider)
 *
 * Everything that DECIDES a cycle. Touches no data line and no address line.
 *
 * Re-partition changes from rev 0:
 *   - the AD0-15 address latch + burst counter moved to CPLD 1 (z280-s100-ad.pld),
 *     so LATCH_LE / SRAM_A0 / SRAM_A1 / B0 / B1 are gone.
 *   - A16-23 decode moved to external 74F138 (SRAM_WIN) + 74F521 (FLASH_WIN,
 *     SLAVE_WIN). This part just reads the four decode results.
 *   - steering to CPLD 1 is now pre-qualified: MST_RD / MST_WR / SLV_RD / SLV_WR
 *     (+ XFR16, SPLIT, SLAVE), so CPLD 1 has no decode to do.
 *   - LA0 arrives from CPLD 1 (it owns the byte lane).
 *   - S100_DIR moved to CPLD 1 (= !SLAVE); this part keeps the three 245 OEs.
 *
 * Pinout: ATF1508AS 84-pin PLCC. JTAG = TDI 14 / TMS 23 / TCK 62 / TDO 71.
 * DEDICATED inputs: GCLR=1, OE2=2, GCLK1=83, OE1=84 (tied +5V in the schematic
 * except GCLK1=83 = Z_CLK_IN). 60 general I/O + pin 83 all used (61 signals).
 * ========================================================================== */

/* *************** INPUT PINS *********************/
PIN 77  = Z_AS;       /* Z-BUS address strobe, active low */
PIN 79  = Z_DS;       /* Z-BUS data strobe, active low */
PIN 4   = Z_RW;       /* read/write, low = write */
PIN 5   = Z_BW;       /* byte/word, low = word */
PIN 6   = Z_ST0;
PIN 8   = Z_ST1;
PIN 9   = Z_ST2;
PIN 10  = Z_ST3;
PIN 11  = Z_IE;       /* input enable (read), active low */
PIN 15  = Z_BUSACK;   /* BUSACK: 0=relinquished(slave) 1=owns(master) */
PIN 83  = Z_CLK_IN;   /* GCK1 - bus clock */
PIN 16  = Z_RESET;
PIN 17  = S100_INT;   /* backplane interrupt, active low */
PIN 18  = S100_NMI;
PIN 20  = S100_HOLD;  /* temporary-master request, active low */
PIN 21  = S100_pRDY;  /* master ready (read only; slave side always ready) */
PIN 22  = S100_XRDY;
PIN 12  = S100_ADSB;  /* address disable, active low */
PIN 25  = S100_SDSB;  /* status disable, active low */
PIN 28  = S100_CDSB;  /* control disable, active low */
PIN 30  = SRAM_WIN;   /* from 74F138 Y0: 2 MB window 000000-1FFFFF */
PIN 31  = FLASH_WIN;  /* from 74F521: F00000-F0FFFF */
PIN 29  = SLAVE_WIN;  /* from 74F521: DIP-strapped TMA slave window */
PIN 33  = A20;       /* A20, straight off the upper address bus */
PIN 27  = LA0;        /* from CPLD 1: byte lane (was the '573 output) */
PIN 62  = TCK;        /* JTAG */
PIN 23  = TMS;
PIN 14  = TDI;

/* *************** OUTPUT PINS *********************/
PIN 34  = !Z_WAIT;    /* hold the Z280, active low */
PIN 35  = !Z_INT;
PIN 36  = !Z_NMI;
PIN 37  = !Z_BUSREQ;  /* request Z280 bus, active low */
PIN 49  = CPLD_pSYNC;
PIN 50  = !CPLD_pSTVAL;
PIN 51  = CPLD_pDBIN;
PIN 52  = !CPLD_pWR;
PIN 54  = CPLD_pHLDA;
PIN 55  = !MEM_CE0;
PIN 56  = !MEM_CE1;
PIN 57  = !MEM_OE;
PIN 58  = !MEM_WE_L;
PIN 60  = !MEM_WE_H;
PIN 61  = !FLASH_CE;
PIN 63  = !FLASH_OE;
PIN 76  = !FLASH_WE;  /* 28C256 write enable - in-system EEPROM programming */
PIN 75  = !CFG_OE;    /* BTI 74HCT244 /OE - drive AD0-7 during reset + hold */
PIN 64  = !S100_A_OE; /* address 245 enable, active low */
PIN 65  = !S100_S_OE; /* status 245 enable, active low */
PIN 67  = !S100_C_OE; /* control 245 enable, active low */
PIN 69  = MST_RD;     /* -> CPLD 1: master S-100 read */
PIN 70  = MST_WR;     /* -> CPLD 1: master S-100 write */
PIN 80  = SLV_RD;     /* -> CPLD 1: TMA reads our SRAM */
PIN 81  = SLV_WR;     /* -> CPLD 1: TMA writes our SRAM */
PIN 74  = XFR16;      /* -> CPLD 1: 16-bit transfer agreed */
PIN 73  = SPLIT;      /* -> CPLD 1: second byte of a 16->8 split */
PIN 68  = SLAVE;      /* -> CPLD 1: board is a bus slave */
PIN 71  = TDO;        /* JTAG */

/* *************** BIDIRECTIONAL PINS *********************/
PIN 39  = CPLD_sMEMR;
PIN 40  = !CPLD_sWO;
PIN 41  = CPLD_sINP;
PIN 44  = CPLD_sOUT;
PIN 45  = CPLD_sINTA;
PIN 46  = CPLD_sHLTA;
PIN 48  = !CPLD_sXTRQ;
PIN 24  = S100_SIXTN;  /* read as master, drive low as slave */

/* *************** STATE REGISTER *************** */
node S1;   /* master FSM: IDLE=00, SYNC=01, DATA=10 */
node S0;
node CNT3; /* reset-config hold counter (15 clocks after reset) */
node CNT2;
node CNT1;
node CNT0;

/* SPLIT is a registered OUTPUT pin (pin 73), not a buried node - it is the
 * 16->8 split flag, sent to CPLD 1 so it can drive S-100 A0. */

S1.CK = Z_CLK_IN;
S0.CK = Z_CLK_IN;
SPLIT.CK = Z_CLK_IN;
CNT3.CK = Z_CLK_IN;
CNT2.CK = Z_CLK_IN;
CNT1.CK = Z_CLK_IN;
CNT0.CK = Z_CLK_IN;
S1.AR = !Z_RESET;
S0.AR = !Z_RESET;
SPLIT.AR = !Z_RESET;
CNT3.AR = !Z_RESET;
CNT2.AR = !Z_RESET;
CNT1.AR = !Z_RESET;
CNT0.AR = !Z_RESET;

/* *************** COMBINATIONAL DECODE *************** */
MEM   = Z_ST3 & !Z_ST2 & !Z_ST1;              /* 1000/1001 memory */
IO    = !Z_ST3 & !Z_ST2 & Z_ST1 & !Z_ST0;     /* 0010 I/O */
WRITE = !Z_RW;
WORD  = !Z_BW;

/* SRAM_WIN / FLASH_WIN / SLAVE_WIN arrive decoded from the F138 / F521. */
LOCAL_ADDR = SRAM_WIN # FLASH_WIN;

S100_CYCLE = (MEM & !LOCAL_ADDR) # IO;
READY      = S100_pRDY # S100_XRDY;

SLAVE  = !Z_BUSACK;   /* 1 = board is a bus slave */
MASTER = Z_BUSACK;    /* 1 = board is the bus master */

START      = S100_CYCLE & MASTER;
S100_ACTIVE = (S1 # S0) & MASTER;

SPLIT16 = WORD & !S100_SIXTN;   /* word access, slave did NOT ack 16-bit */

BYTE_SEL = LA0 # SPLIT;         /* internal; CPLD 1 drives S-100 A0 */

/* *************** MASTER BRIDGE FSM *************** */
S1.D = (S0 & !S1)
     # (S1 & !S0 & !READY);

S0.D = (!S1 & !S0 & START)
     # (S1 & !S0 & READY & SPLIT16 & !SPLIT);

SPLIT.D = (S1 & !S0 & READY & SPLIT16 & !SPLIT)
        # (SPLIT & !(S1 & !S0 & READY));

/* *************** RESET CONFIG HOLD COUNTER *************** */
/* The Z280 loads its BTI register from AD0-7 on the rising edge of RESET and
 * requires WAIT asserted >=4 clocks before that edge and held >=6 clocks after
 * (p.541/545); AD0-7 hold time equals the WAIT dwell. The CPU won't run until
 * WAIT rises anyway, so we use the full 4-bit count and hold 15 clocks. */
HOLD = !(CNT3 & CNT2 & CNT1 & CNT0); /* 1 while CNT is 0..14 (15 clocks) */
INC  = !Z_RESET & HOLD;         /* count only after reset, stop at 15 */

CNT0.D = CNT0 $ INC;
CNT1.D = CNT1 $ (INC & CNT0);
CNT2.D = CNT2 $ (INC & CNT1 & CNT0);
CNT3.D = CNT3 $ (INC & CNT2 & CNT1 & CNT0);

CFG_OE = HOLD;                  /* BTI 74HCT244 /OE (pin 75, active low) */

/* *************** S-100 CONTROL / STATUS *************** */
CPLD_pSYNC   = S0 & !S1;
CPLD_pSTVAL  = S0 & !S1;
CPLD_pDBIN   = S1 & !S0 & !WRITE;
CPLD_pWR     = S1 & !S0 & WRITE;

Z_WAIT       = S100_ACTIVE # HOLD;

CPLD_sMEMR   = MEM & S100_ACTIVE;
CPLD_sWO     = WRITE & S100_ACTIVE;
CPLD_sINP    = IO & !WRITE & S100_ACTIVE;
CPLD_sOUT    = IO & WRITE & S100_ACTIVE;
CPLD_sINTA   = !Z_ST3 & Z_ST2 & S100_ACTIVE;
CPLD_sHLTA   = !Z_ST3 & !Z_ST2 & Z_ST1 & Z_ST0 & S100_ACTIVE;
CPLD_sXTRQ   = WORD & S100_ACTIVE & !SPLIT;

CPLD_sMEMR.OE  = S100_ACTIVE;
CPLD_sWO.OE    = S100_ACTIVE;
CPLD_sINP.OE   = S100_ACTIVE;
CPLD_sOUT.OE   = S100_ACTIVE;
CPLD_sINTA.OE  = S100_ACTIVE;
CPLD_sHLTA.OE  = S100_ACTIVE;
CPLD_sXTRQ.OE  = S100_ACTIVE;
CPLD_pSYNC.OE  = S100_ACTIVE;
CPLD_pSTVAL.OE = S100_ACTIVE;
CPLD_pDBIN.OE  = S100_ACTIVE;
CPLD_pWR.OE    = S100_ACTIVE;

/* *************** LOCAL MEMORY *************** */
MEM_CE0 = (MEM & SRAM_WIN & MASTER & !A20)
        # (SLAVE & SLAVE_WIN & CPLD_sMEMR & !A20);
MEM_CE1 = (MEM & SRAM_WIN & MASTER &  A20)
        # (SLAVE & SLAVE_WIN & CPLD_sMEMR &  A20);

MEM_OE  = (Z_IE & MASTER & SRAM_WIN)
        # (SLAVE & SLAVE_WIN & CPLD_sMEMR & !CPLD_sWO);

MEM_WE_L = (WRITE & Z_DS & (WORD # !LA0) & SRAM_WIN & MASTER)
         # (SLAVE & SLAVE_WIN & CPLD_sMEMR & CPLD_sWO & !BYTE_SEL);
MEM_WE_H = (WRITE & Z_DS & (WORD #  LA0) & SRAM_WIN & MASTER)
         # (SLAVE & SLAVE_WIN & CPLD_sMEMR & CPLD_sWO &  BYTE_SEL);

FLASH_CE = MEM & FLASH_WIN & MASTER;
FLASH_OE = Z_IE & FLASH_WIN & MASTER;
FLASH_WE = WRITE & Z_DS & FLASH_WIN & MASTER;

/* *************** SLAVE MODE / ARBITRATION *************** */
Z_BUSREQ = !S100_HOLD;

/* pHLDA is the permanent master's exclusive output; always driven, never
 * CDSB-gated (one master, temporaries return through it). */
CPLD_pHLDA = !Z_BUSACK;
CPLD_pHLDA.OE = 'b'1;

/* SIXTN# (16-bit acknowledge): a master asserts sXTRQ and the slave answers
 * SIXTN. Pin 24 is bidirectional: read as master (SPLIT16), driven open-drain
 * low as slave when a TMA requests 16-bit inside our window. */
S100_SIXTN    = 'b'0;
S100_SIXTN.OE = SLAVE & CPLD_sXTRQ & SLAVE_WIN;

/* *************** BUFFER CONTROL *************** */
S100_A_OE = S100_ADSB # SLAVE;
S100_S_OE = S100_SDSB # SLAVE;
S100_C_OE = S100_CDSB # SLAVE;

/* *************** STEERING DECISIONS (-> CPLD 1) *************** */
/* Pre-qualified so the data path has no decode left to do. */
MST_RD = S100_ACTIVE & !WRITE;
MST_WR = S100_ACTIVE &  WRITE;
SLV_RD = SLAVE & SLAVE_WIN & !CPLD_sWO;
SLV_WR = SLAVE & SLAVE_WIN &  CPLD_sWO;

XFR16  = (MASTER & WORD & S100_SIXTN) # (SLAVE & CPLD_sXTRQ);

/* *************** INTERRUPTS *************** */
Z_INT = !S100_INT;
Z_NMI = !S100_NMI;
