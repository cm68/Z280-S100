Name     Z280 S-100 CPU card - AD / data-path CPLD ;
PartNo   ATF1508 ;
Date     2026-08-27 ;
Revision 2 ;
Designer ;
Company  ;
Assembly ;
Location ;
Device   f1508ispplcc84 ;

/* ============================================================================
 * Z280 S-100 CPU card - AD CPLD (CPLD 1)
 *
 * Sole owner of the multiplexed Z-BUS. Everything that MOVES BITS lives here:
 *   - the AD0-15 byte mux to the S-100 DO/DI lanes (through two 74F245s)
 *   - the 2-bit burst address counter (A1/A2) + the byte lane (A0)
 *
 * It decides nothing. The control CPLD (CPLD 2) hands it four pre-qualified
 * steering terms - MST_RD, MST_WR, SLV_RD, SLV_WR - plus XFR16, SPLIT and
 * SLAVE, and gets back LA0 (the byte-lane bit) which only this part can see.
 *
 * A0-A2 drive the on-card SRAM/flash address AND the S-100 address 245s. The
 * plain A3-A15 address bits moved OUT to two 74HC573 latches (LATCH_LE = ~AS)
 * to make room for the data-bus buffer DIRs; those 573s float their Q outputs
 * on SLAVE exactly as the old in-CPLD register did. A0 stays bidirectional so
 * a temporary master can drive S-100 A0 inward through the reversed 245s.
 *
 * The S-100 DO0-7 / DI0-7 lanes are NOT driven directly any more. This part's
 * CPLD_DO/CPLD_DI pins feed the A-side of two 74F245 transceivers whose B-side
 * is the backplane; DO_DIR / DI_DIR are their DIR pins (1 = A->B = drive). The
 * 245 /OE is tied low -- a 245 in receive mode never drives the bus, so DIR is
 * the only control that matters.
 *
 * Pinout: ATF1508AS 84-pin PLCC. JTAG = TDI 14 / TMS 23 / TCK 62 / TDO 71.
 * DEDICATED inputs: GCLR=1, OE2=2, GCLK1=83, OE1=84 (tied +5V in the schematic
 * except GCLK1=83 = Z_CLK_IN). 53 general I/O used; FREE for a future rev:
 * 65, 67, 68, 69, 70, 73, 74.
 * ========================================================================== */

/* *************** INPUTS *********************/
PIN 4   = A0;   /* byte lane */
PIN 5   = A1;   /* burst counter */
PIN 6   = A2;   /* burst counter */
PIN 8   = LATCH_LE;   /* 74HC573 latch enable = !Z_AS */
PIN 9   = AD7;
PIN 10  = AD8;
PIN 11  = AD9;
PIN 12  = MST_RD;   /* from 2: master S-100 read (drive AD from bus) */
PIN 15  = MST_WR;   /* from 2: master S-100 write (drive DO/DI from AD) */
PIN 16  = SLV_RD;   /* from 2: TMA reads our SRAM (drive DO/DI) */
PIN 17  = SLV_WR;   /* from 2: TMA writes our SRAM (drive AD) */
PIN 18  = XFR16;   /* from 2: 16-bit transfer agreed */
PIN 20  = SPLIT;   /* from 2: second byte of a 16->8 split */
PIN 21  = SLAVE;   /* from 2: board is a bus slave - float A0-15 */
PIN 22  = LA0;   /* to 2: byte lane */
PIN 24  = AD0;
PIN 25  = AD1;
PIN 27  = AD2;
PIN 28  = AD3;
PIN 29  = AD4;
PIN 30  = AD5;
PIN 31  = AD6;
PIN 33  = CPLD_DO0;
PIN 34  = CPLD_DO1;
PIN 35  = CPLD_DO2;
PIN 36  = CPLD_DO3;
PIN 37  = CPLD_DO4;
PIN 39  = CPLD_DO5;
PIN 40  = CPLD_DO6;
PIN 41  = CPLD_DO7;
PIN 44  = CPLD_DI0;
PIN 45  = CPLD_DI1;
PIN 46  = CPLD_DI2;
PIN 48  = CPLD_DI3;
PIN 49  = CPLD_DI4;
PIN 50  = CPLD_DI5;
PIN 51  = CPLD_DI6;
PIN 52  = CPLD_DI7;
PIN 54  = Z_AS;   /* Z-BUS address strobe, active low */
PIN 55  = Z_DS;   /* Z-BUS data strobe, active low - burst increment */
PIN 56  = !Z_INT;   /* to Z280 INT-A (active low) */
PIN 57  = !Z_NMI;   /* to Z280 NMI (active low) */
PIN 58  = DO_DIR;   /* 74F245 DO DIR: 1 = drive DO */
PIN 60  = DI_DIR;   /* 74F245 DI DIR: 1 = drive DI */
PIN 61  = S100_DODSB;   /* data-out disable - gates DO/DI drive */
PIN 63  = S100_INT;   /* backplane interrupt, active low */
PIN 64  = S100_NMI;   /* backplane NMI */
PIN 75  = AD10;
PIN 76  = AD11;
PIN 77  = AD12;
PIN 79  = AD13;
PIN 80  = AD14;
PIN 81  = AD15;
PIN 83  = Z_CLK_IN;   /* GCLK1 - bus clock, drives the burst counter */
PIN 62  = TCK;   /* JTAG */
PIN 23  = TMS;   /* JTAG */
PIN 14  = TDI;   /* JTAG */
PIN 71  = TDO;   /* JTAG */

/* *************** ADDRESS REGISTER *************** */
/* Edge-triggered on AS rising: the Z-BUS presents a valid address before AS
 * deasserts, so the rising edge is the natural capture point. Only A0 remains
 * here; A3-A15 are latched by the external 74HC573s. */
node LA0R;              /* registered AD0 - the raw byte address */

LA0R.CK = Z_AS;   LA0R.D = AD0;

/* *************** BURST ADDRESS COUNTER *************** */
/* Loads the latched address on AS, increments on each DS stroke. A normal
 * access (1 DS) leaves A1/A2 at the latched value; a cache-line burst
 * (1 AS + 4 DS) steps them 00->01->10->11. A0 stays 0 on word transfers. */
LOAD  = !Z_AS;
COUNT = !Z_DS;

A1.CK = Z_CLK_IN;
A2.CK = Z_CLK_IN;

A1.D = (LOAD & AD1) # (!LOAD & (A1 $ COUNT));
A2.D = (LOAD & AD2) # (!LOAD & (A2 $ (COUNT & A1)));

/* 573 latch enable: transparent while AS is low, holds on the rising edge. */
LATCH_LE = !Z_AS;

/* *************** BYTE LANE *************** */
/* S-100 A0 carries the SPLIT-advanced byte address; local SRAM only ever sees
 * non-split cycles, so one equation serves both. */
A0 = LA0R # SPLIT;

/* What CPLD 2 needs for MEM_WE_L/H steering: our latched value as master, the
 * TMA's A0 read off the pin as slave. */
LA0 = (!SLAVE & (LA0R # SPLIT)) # (SLAVE & A0);

/* Float the whole address bus when a temporary master owns it. The 74HC573s
 * float A3-A15 via their /OE tied to SLAVE the same way. */
A0.OE  = !SLAVE;   A1.OE  = !SLAVE;   A2.OE  = !SLAVE;

/* *************** DIRECTION *************** */
BYTE_SEL = LA0R # SPLIT;

DRIVE_AD = MST_RD # SLV_WR;                              /* bus -> AD */
DRIVE_DO = (MST_WR # (SLV_RD & XFR16)) & S100_DODSB;     /* AD -> DO (buried) */
DRIVE_DI = ((MST_WR & XFR16) # SLV_RD) & S100_DODSB;     /* AD -> DI (buried) */

/* The 74F245 DIR pins mirror the buried drive enables. A pin output can't
 * feed another pin's .OE product term directly -- that trips the fitter's
 * extra-wiring check -- so the .OE equations below use the buried nodes, and
 * only the pins' own equations reference DO_DIR/DI_DIR. */
DO_DIR = DRIVE_DO;
DI_DIR = DRIVE_DI;

/* Which S-100 lane feeds each AD byte on a master read / slave write. */
AD_EVEN_SRC_DO = (MST_RD & XFR16) # (SLV_WR & !BYTE_SEL);
AD_EVEN_SRC_DI = MST_RD & !XFR16 & !BYTE_SEL;
AD_ODD_SRC_DI  = MST_RD & (XFR16 # BYTE_SEL);
AD_ODD_SRC_DO  = SLV_WR & BYTE_SEL;

/* *************** BYTE MUX *************** */
/* The Z280 byte-swap puts even (A0=0) on AD8-15, odd (A0=1) on AD0-7. */
AD0  = (AD_ODD_SRC_DI & CPLD_DI0) # (AD_ODD_SRC_DO & CPLD_DO0);
AD1  = (AD_ODD_SRC_DI & CPLD_DI1) # (AD_ODD_SRC_DO & CPLD_DO1);
AD2  = (AD_ODD_SRC_DI & CPLD_DI2) # (AD_ODD_SRC_DO & CPLD_DO2);
AD3  = (AD_ODD_SRC_DI & CPLD_DI3) # (AD_ODD_SRC_DO & CPLD_DO3);
AD4  = (AD_ODD_SRC_DI & CPLD_DI4) # (AD_ODD_SRC_DO & CPLD_DO4);
AD5  = (AD_ODD_SRC_DI & CPLD_DI5) # (AD_ODD_SRC_DO & CPLD_DO5);
AD6  = (AD_ODD_SRC_DI & CPLD_DI6) # (AD_ODD_SRC_DO & CPLD_DO6);
AD7  = (AD_ODD_SRC_DI & CPLD_DI7) # (AD_ODD_SRC_DO & CPLD_DO7);
AD8  = (AD_EVEN_SRC_DO & CPLD_DO0) # (AD_EVEN_SRC_DI & CPLD_DI0);
AD9  = (AD_EVEN_SRC_DO & CPLD_DO1) # (AD_EVEN_SRC_DI & CPLD_DI1);
AD10 = (AD_EVEN_SRC_DO & CPLD_DO2) # (AD_EVEN_SRC_DI & CPLD_DI2);
AD11 = (AD_EVEN_SRC_DO & CPLD_DO3) # (AD_EVEN_SRC_DI & CPLD_DI3);
AD12 = (AD_EVEN_SRC_DO & CPLD_DO4) # (AD_EVEN_SRC_DI & CPLD_DI4);
AD13 = (AD_EVEN_SRC_DO & CPLD_DO5) # (AD_EVEN_SRC_DI & CPLD_DI5);
AD14 = (AD_EVEN_SRC_DO & CPLD_DO6) # (AD_EVEN_SRC_DI & CPLD_DI6);
AD15 = (AD_EVEN_SRC_DO & CPLD_DO7) # (AD_EVEN_SRC_DI & CPLD_DI7);

AD0.OE  = DRIVE_AD;   AD1.OE  = DRIVE_AD;   AD2.OE  = DRIVE_AD;
AD3.OE  = DRIVE_AD;   AD4.OE  = DRIVE_AD;   AD5.OE  = DRIVE_AD;
AD6.OE  = DRIVE_AD;   AD7.OE  = DRIVE_AD;   AD8.OE  = DRIVE_AD;
AD9.OE  = DRIVE_AD;   AD10.OE = DRIVE_AD;   AD11.OE = DRIVE_AD;
AD12.OE = DRIVE_AD;   AD13.OE = DRIVE_AD;   AD14.OE = DRIVE_AD;
AD15.OE = DRIVE_AD;

CPLD_DO0 = (BYTE_SEL & AD0) # (!BYTE_SEL & AD8);
CPLD_DO1 = (BYTE_SEL & AD1) # (!BYTE_SEL & AD9);
CPLD_DO2 = (BYTE_SEL & AD2) # (!BYTE_SEL & AD10);
CPLD_DO3 = (BYTE_SEL & AD3) # (!BYTE_SEL & AD11);
CPLD_DO4 = (BYTE_SEL & AD4) # (!BYTE_SEL & AD12);
CPLD_DO5 = (BYTE_SEL & AD5) # (!BYTE_SEL & AD13);
CPLD_DO6 = (BYTE_SEL & AD6) # (!BYTE_SEL & AD14);
CPLD_DO7 = (BYTE_SEL & AD7) # (!BYTE_SEL & AD15);

CPLD_DO0.OE = DRIVE_DO;   CPLD_DO1.OE = DRIVE_DO;
CPLD_DO2.OE = DRIVE_DO;   CPLD_DO3.OE = DRIVE_DO;
CPLD_DO4.OE = DRIVE_DO;   CPLD_DO5.OE = DRIVE_DO;
CPLD_DO6.OE = DRIVE_DO;   CPLD_DO7.OE = DRIVE_DO;

CPLD_DI0 = ((XFR16 # BYTE_SEL) & AD0) # (!(XFR16 # BYTE_SEL) & AD8);
CPLD_DI1 = ((XFR16 # BYTE_SEL) & AD1) # (!(XFR16 # BYTE_SEL) & AD9);
CPLD_DI2 = ((XFR16 # BYTE_SEL) & AD2) # (!(XFR16 # BYTE_SEL) & AD10);
CPLD_DI3 = ((XFR16 # BYTE_SEL) & AD3) # (!(XFR16 # BYTE_SEL) & AD11);
CPLD_DI4 = ((XFR16 # BYTE_SEL) & AD4) # (!(XFR16 # BYTE_SEL) & AD12);
CPLD_DI5 = ((XFR16 # BYTE_SEL) & AD5) # (!(XFR16 # BYTE_SEL) & AD13);
CPLD_DI6 = ((XFR16 # BYTE_SEL) & AD6) # (!(XFR16 # BYTE_SEL) & AD14);
CPLD_DI7 = ((XFR16 # BYTE_SEL) & AD7) # (!(XFR16 # BYTE_SEL) & AD15);

CPLD_DI0.OE = DRIVE_DI;   CPLD_DI1.OE = DRIVE_DI;
CPLD_DI2.OE = DRIVE_DI;   CPLD_DI3.OE = DRIVE_DI;
CPLD_DI4.OE = DRIVE_DI;   CPLD_DI5.OE = DRIVE_DI;
CPLD_DI6.OE = DRIVE_DI;   CPLD_DI7.OE = DRIVE_DI;

/* *************** INTERRUPTS (moved from control CPLD) *************** */
/* S-100 INT/NMI are active-low and the Z280 wants them active-low, so the
 * pin (declared !Z_INT/!Z_NMI above) is a net pass-through. */
Z_INT = !S100_INT;
Z_NMI = !S100_NMI;
